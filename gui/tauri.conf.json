{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "untracx",
  "version": "0.1.0",
  "identifier": "com.untracx.app",
  "build": {
    "frontendDist": "../gui/frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "untracx",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}